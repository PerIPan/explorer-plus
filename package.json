  "dependencies": {
    "@vercel/node": "^5.6.18",
    "@vercel/postgres": "^0.10.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
